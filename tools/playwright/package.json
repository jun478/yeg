{
  "name": "yeg-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:responsive": "playwright test tests/responsive",
    "test:interactions": "playwright test tests/interactions",
    "test:external": "playwright test tests/smoke tests/responsive",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots=missing",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
